{
  "functions": {
    "api/product.js": {
      "maxDuration": 5
    },
    "api/create-order.js": {
      "maxDuration": 10
    },
    "api/verify-payment.js": {
      "maxDuration": 5
    },
    "api/google-index.js": {
      "maxDuration": 10
    },
    "api/shop.js": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "embroiderybysana.live"
        }
      ],
      "destination": "https://www.crochetwali.in/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.embroiderybysana.live"
        }
      ],
      "destination": "https://www.crochetwali.in/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "crochetwali.in"
        }
      ],
      "destination": "https://www.crochetwali.in/$1",
      "permanent": true
    },
    {
      "source": "/product/(.*)c8817e89-bd13-4b44-80d9-e93a7dfb8ce8(.*)",
      "destination": "https://www.crochetwali.in/product/crochet-parandi-4fdb8975-eac9-4ecf-bb82-61526f2625a1",
      "permanent": true
    },
    {
      "source": "/product/(.*)b847a5ce-57c4-4b9b-862d-fb305a50c102(.*)",
      "destination": "https://www.crochetwali.in/product/sunflower-keychain-a3464d61-a5da-4471-93d4-b7615de02e8f",
      "permanent": true
    },
    {
      "source": "/product/(.*)b93361d2-1709-421e-b98b-443bffd21cfb(.*)",
      "destination": "https://www.crochetwali.in/product/crochet-wrist-gajra-bracelet-pair-f6439b6e-b495-4d17-95f2-7bcd7d7fdd26",
      "permanent": true
    },
    {
      "source": "/product/(.*)e6d2aa67-4a7d-4dfb-ad09-ec1fd25f6bc2(.*)",
      "destination": "https://www.crochetwali.in/product/crochet-wrist-gajra-bracelet-pair-f6439b6e-b495-4d17-95f2-7bcd7d7fdd26",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/category-images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/promo-images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/custom-images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/sitemap_images.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/merchant-feed.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "unsafe-none"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/product/:slug*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(.*)(bot|crawler|spider|facebookexternalhit|WhatsApp|Twitterbot|Pinterest|LinkedInBot|Googlebot|bingbot|Baiduspider|YandexBot|curl|wget|slurp|DuckDuckBot|PostmanRuntime|Screaming|Lighthouse|HeadlessChrome|Google-InspectionTool)(.*)"
        }
      ],
      "destination": "/api/product.js?slug=:slug*"
    },
    {
      "source": "/product/:slug*",
      "has": [
        {
          "type": "query",
          "key": "crawler"
        }
      ],
      "destination": "/api/product.js?slug=:slug*"
    },
    {
      "source": "/product/:slug*",
      "has": [
        {
          "type": "query",
          "key": "bot"
        }
      ],
      "destination": "/api/product.js?slug=:slug*"
    },
    {
      "source": "/shop",
      "destination": "/api/shop.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
